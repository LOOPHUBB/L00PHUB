local HopperSection = Tabs.ServerHopper:AddSection("🌐 SERVER HOPPER")

local HopperEngine = {
    IsAutoHopping = false,
    HOP_INTERVAL = 5
}

function HopperEngine:Get1PlayerServers()
    local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(game.PlaceId)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if not ok or not res then return {} end
    local ok2, data = pcall(function() return HttpService:JSONDecode(res) end)
    if not ok2 or not data or not data.data then return {} end

    local list = {}
    for _, s in ipairs(data.data) do
        -- Exactly 1 player + not the server we are currently in
        if s.playing == 1 and s.id ~= game.JobId then
            table.insert(list, s)
        end
    end
    return list
end

function HopperEngine:Hop()
    Fluent:Notify({
        Title = "Server Hopper",
        Content = "Searching for 1-player server...",
        Duration = 3
    })

    local servers = self:Get1PlayerServers()
    if #servers == 0 then
        Fluent:Notify({
            Title = "Server Hopper",
            Content = "None found — retrying...",
            Duration = 3
        })
        return false
    end

    local pick = servers[math.random(1, #servers)]
    Fluent:Notify({
        Title = "Server Hopper",
        Content = "Joining (" .. pick.playing .. " player)...",
        Duration = 3
    })

    pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, pick.id, lp)
    end)
    return true
end

HopperSection:AddButton({
    Title = "🔎 Find 1-Player Server",
    Description = "Instantly hop to a server with exactly 1 player",
    Callback = function()
        task.spawn(function()
            HopperEngine:Hop()
        end)
    end
})

local AutoHopToggle = HopperSection:AddToggle("AutoHopToggle", {
    Title = "Auto Server Hop",
    Description = "Automatically search every 5s for 1-player servers",
    Default = false
})

AutoHopToggle:OnChanged(function()
    HopperEngine.IsAutoHopping = AutoHopToggle.Value
    
    if HopperEngine.IsAutoHopping then
        Fluent:Notify({
            Title = "Server Hopper",
            Content = "Auto Hop: ENABLED (Searching every " .. HopperEngine.HOP_INTERVAL .. "s)",
            Duration = 3
        })
    else
        Fluent:Notify({
            Title = "Server Hopper",
            Content = "Auto Hop: DISABLED",
            Duration = 3
        })
    end
end)

-- Dedicated Auto Hop Execution Loop
task.spawn(function()
    while true do
        if HopperEngine.IsAutoHopping then
            for i = HopperEngine.HOP_INTERVAL, 1, -1 do
                if not HopperEngine.IsAutoHopping then break end
                task.wait(1)
            end
            if HopperEngine.IsAutoHopping then
                HopperEngine:Hop()
                task.wait(8)
            end
        else
            task.wait(0.5)
        end
    end
end)

