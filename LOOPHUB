local MovementSection = Tabs.Settings:AddSection("⚡ MOVEMENT")

local MovementEngine = {
    Enabled = false,
    TargetSpeed = 16,
    DefaultSpeed = 16
}

local SpeedToggle = MovementSection:AddToggle("BypassSpeedToggle", {
    Title = "Bypass Speed",
    Description = "Toggle velocity movement engine",
    Default = false
})

SpeedToggle:OnChanged(function()
    MovementEngine.Enabled = SpeedToggle.Value
    if not MovementEngine.Enabled and lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
        lp.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = MovementEngine.DefaultSpeed
    end
end)

local SpeedSlider = MovementSection:AddSlider("WalkSpeedSlider", {
    Title = "Speed Multiplier",
    Description = "Adjust target movement velocity",
    Default = 16,
    Min = 16,
    Max = 300,
    Rounding = 0,
    Callback = function(Value)
        MovementEngine.TargetSpeed = Value
    end
})

RunService.Stepped:Connect(function()
    if not MovementEngine.Enabled then return end
    
    local char = lp.Character
    if not char then return end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    
    if humanoid and root and humanoid.Health > 0 then
        humanoid.WalkSpeed = MovementEngine.TargetSpeed
        
        if humanoid.MoveDirection.Magnitude > 0 then
            local velocityDir = humanoid.MoveDirection.Unit
            local currentY = root.AssemblyLinearVelocity.Y
            local velocityFactor = (MovementEngine.TargetSpeed - humanoid.WalkSpeed) + MovementEngine.TargetSpeed
            
            root.AssemblyLinearVelocity = Vector3.new(
                velocityDir.X * velocityFactor,
                currentY,
                velocityDir.Z * velocityFactor
            )
        end
    end
end)

local InfiniteJumpEnabled = false

local InfJumpToggle = MovementSection:AddToggle("InfJump", {
    Title = "Infinite Jump",
    Description = "Jump continuously in mid-air",
    Default = false
})

InfJumpToggle:OnChanged(function()
    InfiniteJumpEnabled = InfJumpToggle.Value
end)

UserInputService.JumpRequest:Connect(function()
    if InfiniteJumpEnabled and lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
        lp.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
    end
end)

